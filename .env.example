# Copy this file to .env and fill in your own Razorpay TEST MODE credentials.
# .env is already gitignored — never commit real keys.
# Get these from: Razorpay Dashboard -> Settings -> API Keys (Test Mode toggled on)

RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# ---------------------------------------------------------------------------
# AI providers — tried in order, failing over on rate limits / errors.
# Each is OPTIONAL: a provider with no key is skipped silently, so the app
# runs with one key or with all of them. If every provider is exhausted, cases
# stay honestly marked `ai_pending` rather than getting an invented verdict.
# ---------------------------------------------------------------------------

# 1st choice. Get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# 2nd choice (failover). Get one from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# 3rd choice (failover). Get one from https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Optional — which model OpenRouter should route to.
# Defaults to google/gemini-2.5-flash. Must support structured JSON output.
# OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional — Groq model. Defaults to llama-3.3-70b-versatile.
# GROQ_MODEL=llama-3.3-70b-versatile
